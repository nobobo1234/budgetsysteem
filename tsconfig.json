{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"allowJs": true,
		"checkJs": true
	},
	"include": ["src", "tests", "*.ts", "scripts/**/*.ts"],
	"exclude": ["src/service-worker"]
}
