# Volgt wat er al staat. Code die Prettier formatteert: tabs, zonder indent_size, want Prettier
# leest .editorconfig en zou daar zijn tabWidth van overnemen.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,cjs,ts,svelte,json,css,html,md}]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[{Dockerfile,*.sh}]
indent_style = space
indent_size = 2

[*.conf]
indent_style = space
indent_size = 4

[Caddyfile]
indent_style = tab
