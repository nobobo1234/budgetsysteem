{
	"name": "budgetsysteem",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.28.6",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:e2e": "ORIGIN=http://localhost:4173 vite build && playwright test",
		"lighthouse": "ORIGIN=http://localhost:4183 vite build && node scripts/lighthouse.mjs",
		"db:generate": "drizzle-kit generate",
		"setup-token": "node scripts/setup-token.mjs",
		"check:invisible": "node scripts/check-invisible-chars.mjs",
		"check:ibans": "node scripts/check-ibans.mjs",
		"check:tests": "node scripts/check-test-count.mjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.0.0",
		"@simplewebauthn/server": "^14.0.3",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"fast-xml-parser": "^5.11.2",
		"pino": "^10.4.0",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@playwright/test": "^1.64.1",
		"@simplewebauthn/browser": "^14.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "5.0.5",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"gsap": "^3.15.0",
		"lighthouse": "^13.5.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"uplot": "^1.6.32",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"web-vitals": "^6.2.3"
	}
}
